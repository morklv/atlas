<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="atlas_terrain">
    <gravity>0 0 -9.81</gravity>
    <physics name="physics" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><cast_shadows>true</cast_shadows><diffuse>0.8 0.82 0.82 1</diffuse><direction>-0.5 0.3 -0.8</direction></light>
    <model name="terrain"><static>true</static><link name="ground"><collision name="collision"><geometry><box><size>12 12 .2</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 12 .2</size></box></geometry><material><diffuse>.58 .61 .60 1</diffuse></material></visual><pose>5 5 -.1 0 0 0</pose></link></model>
    <!-- Dark navigable road segments. The bright blocks are impassable obstacles. -->
    <model name="road_east"><static>true</static><link name="link"><pose>4 1 .015 0 0 0</pose><visual name="v"><geometry><box><size>8 .9 .03</size></box></geometry><material><diffuse>.12 .15 .16 1</diffuse></material></visual></link></model>
    <model name="road_north"><static>true</static><link name="link"><pose>8 4.5 .015 0 0 0</pose><visual name="v"><geometry><box><size>.9 7 .03</size></box></geometry><material><diffuse>.12 .15 .16 1</diffuse></material></visual></link></model>
    <model name="obstacle_a"><static>true</static><link name="link"><pose>3.7 3.6 .75 0 0 0</pose><collision name="c"><geometry><box><size>1.5 1.2 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 1.2 1.5</size></box></geometry><material><diffuse>.78 .8 .79 1</diffuse></material></visual></link></model>
    <model name="obstacle_b"><static>true</static><link name="link"><pose>6.2 6.1 .55 0 0 0</pose><collision name="c"><geometry><box><size>1.1 1.1 1.1</size></box></geometry></collision><visual name="v"><geometry><box><size>1.1 1.1 1.1</size></box></geometry><material><diffuse>.78 .8 .79 1</diffuse></material></visual></link></model>
    <model name="atlas_rover">
      <pose>1 1 .28 0 0 0</pose>
      <link name="chassis"><inertial><mass>8</mass><inertia><ixx>.2</ixx><iyy>.3</iyy><izz>.4</izz></inertia></inertial><collision name="c"><geometry><box><size>.72 .52 .2</size></box></geometry></collision><visual name="v"><geometry><box><size>.72 .52 .2</size></box></geometry><material><diffuse>.23 .28 .29 1</diffuse></material></visual></link>
      <link name="left_wheel"><pose>0 .31 -.12 1.5708 0 0</pose><collision name="c"><geometry><cylinder><radius>.14</radius><length>.08</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.14</radius><length>.08</length></cylinder></geometry><material><diffuse>.07 .08 .08 1</diffuse></material></visual></link>
      <link name="right_wheel"><pose>0 -.31 -.12 1.5708 0 0</pose><collision name="c"><geometry><cylinder><radius>.14</radius><length>.08</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.14</radius><length>.08</length></cylinder></geometry><material><diffuse>.07 .08 .08 1</diffuse></material></visual></link>
      <joint name="left_wheel_joint" type="revolute"><parent>chassis</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <joint name="right_wheel_joint" type="revolute"><parent>chassis</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>.62</wheel_separation><wheel_radius>.14</wheel_radius><topic>/model/atlas_rover/cmd_vel</topic><odom_topic>/model/atlas_rover/odometry</odom_topic><frame_id>world</frame_id><child_frame_id>atlas_rover</child_frame_id></plugin>
    </model>
  </world>
</sdf>
